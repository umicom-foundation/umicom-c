cmake_minimum_required(VERSION 3.24)
if(NOT EXISTS "${TOOL}" OR NOT DEFINED WORK OR NOT DEFINED CASE)
    message(FATAL_ERROR "TOOL, WORK and CASE are required")
endif()
if(NOT CASE MATCHES "^(same|comments|radix|different|same-result|unexecuted-failure|invalid-left|invalid-right|missing-left|missing-right|oversized|arity)$")
    message(FATAL_ERROR "Unknown operation comparison case")
endif()
set(_directory "${WORK}/${CASE}/paths with spaces")
file(MAKE_DIRECTORY "${_directory}")
set(_left "${_directory}/left source.uc")
set(_right "${_directory}/right source.uc")
set(_a "int main(void){return 42;}")
set(_b "${_a}")
set(_expected 0)
set(_word same)
if(CASE STREQUAL "comments")
    set(_b "// moved source coordinates\n\nint main(void) { /* retained meaning */ return 42; }\n")
elseif(CASE STREQUAL "radix")
    set(_a "int main(void){return 0x2a;}")
    set(_b "int main(void){return 0b101010;}")
elseif(CASE STREQUAL "different")
    set(_b "int main(void){return 43;}")
    set(_expected 1)
    set(_word different)
elseif(CASE STREQUAL "same-result")
    set(_a "int main(void){return 2 + 3;}")
    set(_b "int main(void){return 5;}")
    set(_expected 1)
    set(_word different)
elseif(CASE STREQUAL "unexecuted-failure")
    set(_a "int main(void){return 1 / 0;}")
    set(_b "/* no execution */ int main(void){return 1 / 0;}")
elseif(CASE STREQUAL "invalid-left")
    set(_a "int main(void){return ;}")
    set(_expected 2)
elseif(CASE STREQUAL "invalid-right")
    set(_b "int main(void){return ;}")
    set(_expected 2)
elseif(CASE STREQUAL "missing-left" OR CASE STREQUAL "missing-right")
    set(_expected 2)
elseif(CASE STREQUAL "oversized")
    string(REPEAT " " 65537 _b)
    set(_expected 2)
elseif(CASE STREQUAL "arity")
    set(_expected 2)
endif()
file(WRITE "${_left}" "${_a}")
file(WRITE "${_right}" "${_b}")
file(SHA256 "${_left}" _left_before)
file(SHA256 "${_right}" _right_before)
file(GLOB _before LIST_DIRECTORIES FALSE "${_directory}/*")
set(_input_left "${_left}")
set(_input_right "${_right}")
if(CASE STREQUAL "missing-left")
    set(_input_left "${_directory}/never-created-left.uc")
elseif(CASE STREQUAL "missing-right")
    set(_input_right "${_directory}/never-created-right.uc")
endif()
set(_arguments compare-operations "${_input_left}" "${_input_right}")
if(CASE STREQUAL "arity")
    list(APPEND _arguments --max-steps 1)
endif()
execute_process(COMMAND "${TOOL}" ${_arguments}
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 10)
if(NOT "${_result}" STREQUAL "${_expected}")
    message(FATAL_ERROR "${CASE}: exit ${_result}, expected ${_expected}; ${_out} ${_err}")
endif()
if(_expected EQUAL 2)
    if(NOT _out STREQUAL "" OR _err STREQUAL "")
        message(FATAL_ERROR "Invalid input must report an error without a comparison result")
    endif()
    if(CASE STREQUAL "invalid-left" AND NOT _err MATCHES "left source[.]uc:1:[0-9]+:")
        message(FATAL_ERROR "Left diagnostic must identify its source path and location")
    elseif(CASE STREQUAL "invalid-right" AND NOT _err MATCHES "right source[.]uc:1:[0-9]+:")
        message(FATAL_ERROR "Right diagnostic must identify its source path and location")
    endif()
else()
    if(NOT _err STREQUAL "" OR NOT _out MATCHES "operations=${_word}\r?\n" OR
        NOT _out MATCHES "source-locations=not-compared" OR
        NOT _out MATCHES "execution=not-performed" OR _out MATCHES "Result:")
        message(FATAL_ERROR "Unexpected operation comparison report: ${_out} ${_err}")
    endif()
endif()
file(SHA256 "${_left}" _left_after)
file(SHA256 "${_right}" _right_after)
file(GLOB _after LIST_DIRECTORIES FALSE "${_directory}/*")
if(NOT _left_before STREQUAL _left_after OR NOT _right_before STREQUAL _right_after OR
    NOT _before STREQUAL _after)
    message(FATAL_ERROR "Read-only comparison changed an input or created an output")
endif()
message(STATUS "Operation comparison ${CASE} has expected result and preserves inputs")
