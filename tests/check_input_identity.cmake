cmake_minimum_required(VERSION 3.24)
foreach(required IN ITEMS MODULE CHECKER WORK CASE)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing fixture argument: ${required}")
    endif()
endforeach()
include("${MODULE}")
# Each invocation owns a new directory. No recursive removal, real compiler
# mutation or project-source edit is needed to exercise refusal behaviour.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef unique)
set(root "${WORK}/${CASE}-${unique}")
set(source "${root}/source with spaces")
set(binary "${root}/output with spaces")
file(MAKE_DIRECTORY "${source}/src" "${source}/include" "${source}/tools"
    "${source}/cmake" "${source}/examples" "${source}/docs/assets/branding" "${binary}")
file(WRITE "${source}/CMakeLists.txt" "# synthetic project input\n")
file(WRITE "${source}/src/main.c" "int value = 1;\n")
file(WRITE "${source}/include/api.h" "#define VALUE 1\n")
file(WRITE "${source}/cmake/options.cmake" "set(VALUE 1)\n")
file(WRITE "${source}/examples/one.uc" "int main(void) { return 1; }\n")
file(WRITE "${source}/docs/assets/branding/icon.svg" "<svg/>\n")
file(WRITE "${binary}/UmicomCConfig.cmake" "# generated configuration\n")
set(tool "${root}/synthetic compiler")
file(WRITE "${tool}" "compiler driver identity fixture; never executed\n")
set(recipe "${binary}/recipe.json")
set(receipt "${binary}/receipt.json")
umc_input_json_quote(quoted "${tool}")
file(WRITE "${recipe}" "{\"CMAKE_C_COMPILER\":${quoted},\"CMAKE_C_FLAGS\":\"-O0\"}\n")
if(CASE STREQUAL "literal-configuration-token")
    string(ASCII 64 at_sign)
    file(READ "${recipe}" recipe_text)
    umc_input_json_quote(literal "${at_sign}UNDECLARED_VARIABLE${at_sign};path with spaces")
    string(JSON recipe_text SET "${recipe_text}" literalData "${literal}")
    file(WRITE "${recipe}" "${recipe_text}\n")
endif()
umc_input_identity(capture "${source}" "${binary}" "${recipe}" "${receipt}")
umc_input_identity(verify "${source}" "${binary}" "${recipe}" "${receipt}")
file(READ "${receipt}" original)
string(JSON compiled GET "${original}" compilationVerified)
string(JSON stable GET "${original}" sourceStableDuringBuildVerified)
string(JSON unknown_count LENGTH "${original}" unknownInputs)
if(compiled OR stable OR unknown_count LESS 4)
    message(FATAL_ERROR "Record overstates its evidence")
endif()
set(expect_success FALSE)
if(CASE STREQUAL "unchanged" OR CASE STREQUAL "literal-configuration-token")
    set(expect_success TRUE)
elseif(CASE STREQUAL "source")
    file(WRITE "${source}/src/main.c" "int value = 2;\n")
elseif(CASE STREQUAL "added-source")
    file(WRITE "${source}/src/new.c" "int added;\n")
elseif(CASE STREQUAL "deleted-source")
    file(REMOVE "${source}/src/main.c")
elseif(CASE STREQUAL "renamed-source")
    file(RENAME "${source}/src/main.c" "${source}/src/other.c")
elseif(CASE STREQUAL "header")
    file(APPEND "${source}/include/api.h" "#define MORE 2\n")
elseif(CASE STREQUAL "configuration")
    file(APPEND "${source}/cmake/options.cmake" "set(MORE 2)\n")
elseif(CASE STREQUAL "example")
    file(APPEND "${source}/examples/one.uc" "// changed\n")
elseif(CASE STREQUAL "resource")
    file(WRITE "${source}/docs/assets/branding/icon.svg" "<svg><path/></svg>\n")
elseif(CASE STREQUAL "generated")
    file(APPEND "${binary}/UmicomCConfig.cmake" "# changed\n")
elseif(CASE STREQUAL "deleted-generated")
    file(REMOVE "${binary}/UmicomCConfig.cmake")
elseif(CASE STREQUAL "new-generated")
    file(WRITE "${binary}/umicom-c.rc" "// previously absent resource\n")
elseif(CASE STREQUAL "recipe")
    file(WRITE "${recipe}" "{\"CMAKE_C_COMPILER\":${quoted},\"CMAKE_C_FLAGS\":\"-O2\"}\n")
elseif(CASE STREQUAL "tool")
    file(APPEND "${tool}" "different tool bytes\n")
elseif(CASE STREQUAL "missing-tool")
    file(REMOVE "${tool}")
elseif(CASE STREQUAL "missing-receipt")
    file(REMOVE "${receipt}")
elseif(CASE STREQUAL "malformed-receipt")
    file(WRITE "${receipt}" "{")
elseif(CASE STREQUAL "trailing-receipt")
    file(APPEND "${receipt}" "untrusted trailing data")
elseif(CASE STREQUAL "changed-receipt")
    string(JSON altered SET "${original}" compilationVerified true)
    file(WRITE "${receipt}" "${altered}\n")
elseif(CASE STREQUAL "oversized-receipt")
    string(REPEAT " " 16777217 oversized)
    file(WRITE "${receipt}" "${oversized}")
elseif(CASE STREQUAL "receipt-as-code")
    file(WRITE "${receipt}" "file(WRITE [==[${root}/must-not-exist]==] executed)\n")
elseif(CASE STREQUAL "missing-recipe")
    file(REMOVE "${recipe}")
elseif(CASE STREQUAL "nonobject-recipe")
    file(WRITE "${recipe}" "[]\n")
elseif(CASE STREQUAL "prose-outside-scope")
    file(WRITE "${source}/docs/notes.md" "This is not a compiled input.\n")
    set(expect_success TRUE)
elseif(CASE STREQUAL "binary-outside-scope")
    file(WRITE "${binary}/old-program.exe" "This record does not certify binaries.\n")
    set(expect_success TRUE)
else()
    message(FATAL_ERROR "Unknown mutation fixture: ${CASE}")
endif()
if(EXISTS "${receipt}")
    file(SHA256 "${receipt}" before)
else()
    set(before absent)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DSOURCE=${source}" "-DBINARY=${binary}"
    "-DRECIPE=${recipe}" "-DRECEIPT=${receipt}" -P "${CHECKER}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic TIMEOUT 30)
if(expect_success)
    if(NOT result STREQUAL "0" OR NOT output MATCHES "Configured inputs match")
        message(FATAL_ERROR "Expected unchanged declared inputs: ${result} ${output} ${diagnostic}")
    endif()
else()
    if(result STREQUAL "0" OR NOT diagnostic MATCHES "CMake Error")
        message(FATAL_ERROR "Expected a diagnostic refusal: ${result} ${output} ${diagnostic}")
    endif()
endif()
if(EXISTS "${receipt}")
    file(SHA256 "${receipt}" after)
else()
    set(after absent)
endif()
if(NOT before STREQUAL after OR EXISTS "${root}/must-not-exist")
    message(FATAL_ERROR "Verification modified or executed receipt contents")
endif()
message(STATUS "Input identity fixture passed: ${CASE}")
