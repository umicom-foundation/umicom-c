{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "native-debug",
      "displayName": "Umicom C native Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UMICOM_C_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-ucrt64-debug",
      "displayName": "Umicom C Windows UCRT64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-ucrt64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "C:/msys64/ucrt64/bin/gcc.exe",
        "UMICOM_C_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "windows-ucrt64-debug",
      "configurePreset": "windows-ucrt64-debug"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-ucrt64-debug",
      "configurePreset": "windows-ucrt64-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
